# =============================================================================
# Variáveis de Ambiente - PRODUÇÃO
# =============================================================================
# IMPORTANTE: 
# 1. Copie este arquivo para .env.prod
# 2. Substitua TODOS os valores por credenciais seguras
# 3. NUNCA commite o arquivo .env.prod no git
# =============================================================================

# -----------------------------------------------------------------------------
# Database PostgreSQL
# -----------------------------------------------------------------------------
# Use senhas fortes (mínimo 20 caracteres, letras, números e símbolos)
POSTGRES_USER=teacherapp_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_20_CHARS_MIN
POSTGRES_DB=student_management

# -----------------------------------------------------------------------------
# Backend Security
# -----------------------------------------------------------------------------
# SECRET_KEY: Use para assinar tokens JWT
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE_64_BYTES

# Tempo de expiração do token de acesso (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# CORS - Domínios permitidos
# -----------------------------------------------------------------------------
# Lista separada por vírgulas dos domínios que podem acessar a API
CORS_ORIGINS=https://redacaoyana.com.br,https://www.redacaoyana.com.br

# -----------------------------------------------------------------------------
# Portas (ajuste conforme necessário)
# -----------------------------------------------------------------------------
PORT_FRONTEND=80
PORT_FRONTEND_SSL=443

# -----------------------------------------------------------------------------
# Tag da imagem (para versionamento)
# -----------------------------------------------------------------------------
TAG=latest

# =============================================================================
# CHECKLIST DE SEGURANÇA ANTES DO DEPLOY:
# =============================================================================
# [ ] POSTGRES_PASSWORD é uma senha forte e única
# [ ] SECRET_KEY foi gerada com secrets.token_urlsafe(64)
# [ ] CORS_ORIGINS contém apenas domínios confiáveis
# [ ] Arquivo .env.prod está no .gitignore
# [ ] SSL/TLS está configurado (HTTPS)
# [ ] Firewall está configurado (apenas portas 80, 443)
# [ ] Backups automáticos do banco de dados configurados
# =============================================================================
